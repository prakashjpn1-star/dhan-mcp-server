# Never commit real credentials. Use environment variables or mounted secret files.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# DHAN_CLIENT_ID_FILE=
# DHAN_ACCESS_TOKEN_FILE=
# Remote transport only: external OAuth server issuing RS256 access tokens
MCP_OAUTH_ISSUER=
MCP_RESOURCE_URL=
MCP_JWKS_URL=
MCP_ALLOWED_SUBJECT=
MCP_REQUIRED_SCOPE=dhan:read
MCP_BIND_HOST=127.0.0.1
MCP_PORT=8000

# Optional free read-only market data provider
UPSTOX_ANALYTICS_TOKEN=
# UPSTOX_ANALYTICS_TOKEN_FILE=
